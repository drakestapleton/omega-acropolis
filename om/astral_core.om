fn seal_om3d total ulong to void
  sha_reset
  paylen = sub total HDR_BYTES
  k = ulong 0
  while lt k paylen bound 450000
    sha_push get g_out add HDR_BYTES k
    k = add k 1
  end
  sha_finish
end

fn write_om3d total ulong to int
  written = ulong 0
  while lt written total bound 4096
    chunk = sub total written
    if gt chunk 65536
      chunk = 65536
    end
    w = write 1 g_out written chunk
    if le w 0
      ret 2
    end
    written = add written ulong w
  end
  ret 0
end

fn pack_om3d to ulong
  vc = get g_vcount 0
  ic = get g_icount 0
  v_end = add HDR_BYTES mul vc V_STRIDE
  ibytes = mul ic 2
  i = ulong 0
  while lt i ibytes bound 131072
    put g_out add v_end i get g_out add 262144 i
    i = add i 1
  end
  total = add v_end ibytes
  while ne rem total 4 0 bound 8
    put g_out total uchar 0
    total = add total 1
  end
  put g_out 0 uchar 79
  put g_out 1 uchar 77
  put g_out 2 uchar 51
  put g_out 3 uchar 68
  put_u32_le 4 2
  put_u32_le 8 vc
  put_u32_le 12 ic
  put_u32_le 16 V_STRIDE
  put_u32_le 20 1
  put_u32_le 24 0x47454d4f
  put_u32_le 28 0x32303241
  ret total
end

fn finalize_and_write to int
  total = pack_om3d
  seal_om3d total
  ret write_om3d total
end

fn main to int
  init_tables
  build_cosmos
  ret finalize_and_write
end
