length(in.wpos - u.focus.xyz);\\n' +\n      '  let pulse = exp(-fdist * 0.14) * u.focus.w;\\n' +\n      '  let em = in.matp.x;\\n' +\n      '  let dm = clamp(u.params.w, 0.0, 1.0);\\n' +\n      '  let inkCol = mix(in.col, in.col * 0.42 + vec3<f32>(0.02, 0.04, 0.08), dm);\\n' +\n      '  var hdr = inkCol * (0.28 + ndl * 0.95 + em * mix(0.85, 0.35, dm)) + inkCol * (fres * mix(1.35, 0.45, dm) + pulse * 0.95) + vec3<f32>(spec * (1.0 - dm * 0.72));\\n' +\n      '  let dist = length(in.wpos - u.eye.xyz);\\n' +\n      '  let fog = clamp((dist - 12.0) / 145.0, 0.0, 0.88);\\n' +\n      '  hdr = mix(hdr, mix(vec3<f32>(0.0, 0.01, 0.03), vec3<f32>(0.76, 0.84, 0.93), dm), fog);\\n' +\n      '  hdr = (hdr * (2.51 * hdr + 0.03)) / (hdr * (2.43 * hdr + 0.59) + 0.14);\\n' +\n      '  hdr = pow(clamp(hdr, vec3<f32>(0.0), vec3<f32>(1.0)), vec3<f32>(0.4545));\\n' +\n      '  return vec4<f32>(hdr, 1.0);\\n' +\n      '}\\n' +\n      'struct StarOut { @builtin(position) clip: vec4<f32>, @location(0) col: vec3<f32> };\\n' +\n      '@vertex\\n' +\n      'fn vs_star(@location(0) pos: vec4<f32>, @location(1) meta: vec4<f32>, @builtin(vertex_index) vid: u32) -> StarOut {\\n' +\n      '  var o: StarOut;\\n' +\n      '  let tail = f32(vid);\\n' +\n      '  let stretch = (0.35 + u.params.z * 0.85) * (pos.w * 0.028);\\n' +\n      '  let wp = vec3<f32>(pos.x, pos.y, pos.z + tail * stretch);\\n' +\n      '  let st = i32(meta.x + 0.5);\\n' +\n      '  var sc = vec3<f32>(0.22, 0.88, 0.98);\\n' +\n      '  if (st == 1) { sc = vec3<f32>(1.0, 0.82, 0.35); }\\n' +\n      '  else if (st == 2) { sc = vec3<f32>(0.42, 0.68, 1.0); }\\n' +\n      '  else if (st == 3) { sc = vec3<f32>(0.24, 0.88, 0.66); }\\n' +\n      '  let fade = clamp((pos.z + 18.0) / 28.0, 0.0, 1.0) * (1.0 - tail * 0.55);\\n' +\n      '  o.col = mix(sc, vec3<f32>(1.0), 0.45) * (1.25 * fade);\\n' +\n      '  o.clip = u.mvp * vec4<f32>(wp, 1.0);\\n' +\n      '  return o;\\n' +\n      '}\\n' +\n      '@fragment\\n' +\n      'fn fs_star(in: Star