bGL2(canvas, isAmbient, helixMesh, om3dMesh) || createAstralCanvas2D(canvas, isAmbient);\n\n    /* Upgrade asynchronously to WebGPU compute pipeline when browser exposes navigator.gpu */\n    createAstralWebGPU(canvas, isAmbient, helixMesh, om3dMesh).then(function (gpuRen) {\n      if (destroyed || !gpuRen) return;\n      if (renderer && typeof renderer.destroy === 'function') renderer.destroy();\n      renderer = gpuRen;\n    }).catch(function () {});\n\n    loadAndVerifyOm3d(worldUrlOpt).then(function (verified) {\n      if (destroyed || !verified) return;\n      om3dMesh = verified;\n      totalTris = verified.triCount + ((helixMesh.icount / 3) | 0);\n      if (renderer && typeof renderer.uploadOm3d === 'function') renderer.uploadOm3d(verified);\n    });\n\n    /* Camera & State */\n    var theme = initialTheme;\n    var dayTarget = theme === 'parian' ? 1.0 : 0.0;\n    var dayMix = dayTarget;\n    var warpSpeed = isAmbient ? 2.4 : 4.0;\n    var qualityMode = isAmbient ? 'eco' : 'auto';\n    var drsScale = isAmbient ? 0.85 : 1.0;\n\n    var cam = {\n      yaw: OVERVIEW_CAM.yaw, pitch: OVERVIEW_CAM.pitch, dist: OVERVIEW_CAM.dist,\n      tx: OVERVIEW_CAM.tx, ty: OVERVIEW_CAM.ty, tz: OVERVIEW_CAM.tz\n    };\n    var goal = {\n      yaw: OVERVIEW_CAM.yaw, pitch: OVERVIEW_CAM.pitch, dist: OVERVIEW_CAM.dist,\n      tx: OVERVIEW_CAM.tx, ty: OVERVIEW_CAM.ty, tz: OVERVIEW_CAM.tz\n    };\n    var autoOrbit = true;\n    var activePortalIdx = -1;\n    var focusVec = new Float32Array([0, 7.6, -2.5, 0.35]);\n    var eyeVec = new Float32Array(3);\n    var tgtVec = new Float32Array(3);\n    var lastMvp = new Float32Array(16);\n    var projTmp = [0, 0];\n\n    /* omega-observer + omega-play zero-alloc Float32Array(240) CBF frame pacer */\n    var dtRing = new Float32Array(240);\n    var dtSorted = new Float32Array(240);\n    var dtIdx = 0;\n    var dtCount = 0;\n    var p95Ms = 16.6;\n    var stutters = 0;\n    var framesSinceDrs = 0;\n\n    var cssW = 1280, cssH = 720;\n    var isVisible = true;\n    var destroyed = false;\n    var rafId = 0;\n    var lastFrameMs = 0;\n    var lastDrawMs = 0;\n    var lastHudMs = 0;\n\n    function syncSizeCache() {\n      var rect = container.getBoundingClientRect ? container.getBoundingClientRect() : null;\n      cssW = Math.max(320, Math.round(rect && rect.width ? rect.width : (container.width || 1280)));\n      cssH = Math.max(240, Math.round(rect && rect.height ? rect.height : (container.height || 720)));\n      resizeCanvas();\n    }\n\n    function resizeCanvas() {\n      var rawDpr = window.devicePixelRatio || 1;\n      var maxDpr = isAmbient || qualityMode === 'eco' ? 1.0 : (qualityMode === 'crisp' ? 1.6 : 1.35);\n      var maxW = isAmbient || qualityMode === 'eco' ? 1280 : (qualityMode === 'crisp' ? 2560 : 1920);\n      var effDpr = Math.min(rawDpr, maxDpr) * drsScale;\n      var w = Math.max(320, Math.min(maxW, Math.round(cssW * effDpr)));\n      var h = Math.max(240, Math.round(w * (cssH / Math.max(cssW, 1))));\n      if (canvas.width !== w || canvas.height !== h) {\n        canvas.width = w;\n        canvas.height = h;\n      }\n    }\n\n    if (typeof ResizeObserver === 'function') {\n      var ro = new ResizeObserver(syncSizeCache);\n      ro.observe(container);\n    } else if (typeof window.addEventListener === 'function') {\n      window.addEventListener('resize', syncSizeCache);\n    }\n    syncSizeCache();\n\n    /* IntersectionObserver sleeps offscreen portal canvases immediately (0% GPU) */\n    if (!isAmbient && typeof IntersectionObserver === 'function') {\n      var io = new IntersectionObserver(function (entries) {\n        for (var k = 0; k < entries.length; k++) {\n          isVisible = entries[k].isIntersecting;\n        }\n        window.__acropolisPortalActive = isVisible;\n        if (isVisible && !rafId && !destroyed) {\n          lastFrameMs = 0;\n          rafId = requestAnimationFrame(step);\n        }\n      }, { threshold: 0.01 });\n      io.observe(container);\n    }\n\n    function setTheme(next) {\n      theme = next === 'parian' ? 'parian' : 'aegean';\n      dayTarget = theme === 'parian' ? 1.0 : 0.0;\n      container.setAttribute('data-acr-theme', theme);\n      btnTheme.textContent = theme === 'parian' ? 'Solar Corona' : 'Deep Cosmos';\n      var eventDetail = { theme: theme };\n      try { container.dispatchEvent(new CustomEvent('acropolis-theme', { detail: eventDetail })); } catch (_) {}\n    }\n\n    function selectPortal(idx, shouldOpen) {\n      activePortalIdx = idx;\n      for (var i = 0; i < PORTALS.length; i++) {\n        var active = i === idx;\n        pinButtons[i].classList.toggle('acr-pin-active', active);\n        dockButtons[i].classList.toggle('acr-portal-active', active);\n      }\n      if (idx < 0 || idx >= PORTALS.length) {\n        inspector.hidden = true;\n        focusVec[0] = 0; focusVec[1] = 7.6; focusVec[2] = -2.5; focusVec[3] = 0.35;\n        return;\n      }\n      var pt = PORTALS[idx];\n      autoOrbit = false;\n      goal.yaw = pt.cam.yaw;\n      goal.pitch = pt.cam.pitch;\n      goal.dist = pt.cam.dist;\n      goal.tx = pt.cam.tx;\n      goal.ty = pt.cam.ty;\n      goal.tz = pt.cam.tz;\n      focusVec[0] = pt.pos[0]; focusVec[1] = pt.pos[1]; focusVec[2] = pt.pos[2]; focusVec[3] = 1.1;\n\n      audio.playPortal(idx);\n\n      if (shouldOpen !== false) {\n        inspSigil.textContent = pt.sigil;\n        inspEp.textContent = pt.epithet;\n        inspName.textContent = pt.name;\n        inspDesc.textContent = pt.desc;\n        var hashLine = '\\nOM3D SHA-256: ' + (om3dMesh ? (om3dMesh.shaVerified ? 'VERIFIED ' : '') + om3dMesh.shaShort : 'PENDING');\n        inspReceipt.textContent = pt.receipt + hashLine;\n        inspGo.setAttribute('href', resolveRoute(pt, site));\n        inspector.hidden = false;\n      }\n    }\n\n    function resetView() {\n      selectPortal(-1, false);\n      goal.yaw = OVERVIEW_CAM.yaw;\n      goal.pitch = OVERVIEW_CAM.pitch;\n      goal.dist = OVERVIEW_CAM.dist;\n    