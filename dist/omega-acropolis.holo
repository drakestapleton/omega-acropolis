        gl.deleteVertexArray(quadVao);\n      }\n    };\n  }\n\n  /* =========================================================================\n   * BACKEND 3: LIGHTWEIGHT 2D CANVAS FALLBACK (pure black cosmic starfield)\n   * ========================================================================= */\n  function createAstralCanvas2D(canvas, isAmbient) {\n    var ctx = null;\n    try { ctx = canvas.getContext('2d'); } catch (_) { ctx = null; }\n    if (!ctx) return null;\n\n    var pTmp = [0, 0];\n    var colors = ['#22d3ee', '#f5c451', '#60a5fa', '#2dd4a0'];\n\n    function render(mvp, eye, tgt, fov, timeSec, dt, warpSpeed, dayMix) {\n      var w = canvas.width | 0, h = canvas.height | 0;\n      if (w <= 0 || h <= 0) return;\n      ctx.fillStyle = dayMix > 0.5 ? '#dce9fa' : '#000000';\n      ctx.fillRect(0, 0, w, h);\n\n      var cx = w * 0.5, cy = h * 0.5;\n      var stars = isAmbient ? 160 : 280;\n      for (var i = 0; i < stars; i++) {\n        var ang = (i * 2.399963) + timeSec * 0.05;\n        var z = ((i * 1.73 + 120.0 - timeSec * (18.0 + (i % 7) * 6.0) * warpSpeed) % 100.0 + 100.0) % 100.0 + 1.0;\n        var sx = cx + (Math.cos(ang) * (w * 0.52) * (40.0 / z));\n        var sy = cy + (Math.sin(ang) * (h * 0.48) * (40.0 / z));\n        if (sx < 0 || sx > w || sy < 0 || sy > h) continue;\n        ctx.fillStyle = colors[i % 4];\n        var sz = clamp(4.0 / (z * 0.05 + 0.5), 1.0, 3.2);\n        ctx.fillRect(sx, sy, sz, sz);\n      }\n\n      if (!isAmbient) {\n        /* Central 4-strand DNA helix wireframe & portal rings */\n        for (var s = 0; s < 4; s++) {\n          ctx.beginPath();\n          ctx.strokeStyle = colors[s];\n          ctx.lineWidth = 2;\n          for (var k = 0; k <= 36; k++) {\n            var u = k / 36;\n            var a = s * 1.5708 + u * 10.5 + timeSec * 0.9;\n            var hx = Math.cos(a) * 3.3;\n            var hz = -2.5 + Math.sin(a) * 3.3;\n            var hy = -1.0 + u * 18.0;\n            if (projectPoint(mvp, hx, hy, hz,