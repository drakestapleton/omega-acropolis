gn-intelligence/', standalone: '#aien-constellation' },\n      desc: 'Unifies omega-browser, omega-observer, omega-play, omega-arcade, omega-auto, omega-fleet, and sovereign-intelligence: 130 KB pure-OM macOS browser (10.3 MB RAM, 0 JS VM) and 4.25x tighter 0.1% low pacing.',\n      receipt: 'UOR & PLAY: E8_I8 JIT 21.44x vs Rust | 0 stutters >25ms Grace\\nARCADE: 5-way bit-exact pixels | 34x-73x vs Python | 0 OOM'\n    },\n    {\n      id: 'shame',\n      sigil: '\\u0394',\n      name: 'Defense Horizon & Citadel',\n      role: 'WAF, 0.85 ms FaaS, Ledger & Flight CBF',\n      epithet: 'EVENT HORIZON CITADEL',\n      accent: 'terra',\n      color: [0.94, 0.36, 0.24],\n      pos: [6.4, 4.1, 14.8],\n      pinOffset: 4.2,\n      cam: { yaw: 0.34, pitch: 0.22, dist: 15.4, tx: 5.4, ty: 4.4, tz: 13.0 },\n      routes: { aienos: '/privacy/#wall-of-shame', interplane: '/#wall-of-shame', standalone: '#defense-horizon' },\n      desc: 'Unifies omega-shield, omega-immune, omega-lambda, omega-ledger, omega-match, and omega-flight: 4.53M pkts/s WAF (1M x ReDoS safe), 0.85 ms FaaS (324x vs Docker), 6.62M tx/s Merkle DB, and 10 kHz CBF flight.',\n      receipt: 'SECURITY: 26/26 CISA-KEV & CVE blocked | 0/4,096 DB corrupts\\nMATCH & FLIGHT: 37.04M ops/s | 16 Lean 4 theorems (0 sorry)'\n    }\n  ];\n\n  var CELESTIAL_SIGILS = [\n    { glyph: '\\u03A9', phase: 0.0, radius: 17.5, height: 14.8, color: [0.96, 0.77, 0.32] },\n    { glyph: '\\u03A6', phase: 0.90, radius: 19.0, height: 15.6, color: [0.13, 0.83, 0.93] },\n    { glyph: '\\u03C0', phase: 1.80, radius: 18.2, height: 14.4, color: [0.38, 0.65, 0.98] },\n    { glyph: '\\u03B5', phase: 2.70, radius: 19.6, height: 16.0, color: [0.18, 0.83, 0.63] },\n    { glyph: '\\u039B', phase: 3.60, radius: 18.0, height: 14.9, color: [0.38, 0.65, 0.98] },\n    { glyph: '\\u0394', phase: 4.50, radius: 18.9, height: 15.4, color: [0.94, 0.36, 0.24] },\n    { glyph: '\\u03A8', phase: 5.40, radius: 18.4, height: 15.1, color: [0.18, 0.83, 0.63] }\n  ];\n\n  var OVERVIEW_CAM = { yaw: 0.44, pitch: 0.22, dist: 33.5, tx: 0.0, ty: 7.4, tz: 1.2 };\n\n  function clamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }\n  function lerp(a, b, t) { return a + (b - a) * t; }\n\n  function mat4Perspective(fov, aspect, near, far) {\n    var f = 1.0 / Math.tan(fov * 0.5);\n    var nf = 1.0 / (near - far);\n    return new Float32Array([\n      f / aspect, 0, 0, 0,\n      0, f, 0, 0,\n      0, 0, (far + near) * nf, -1,\n      0, 0, 2 * far * near * nf, 0\n    ]);\n  }\n\n  function mat4LookAt(eye, tgt, up) {\n    var zx = eye[0] - tgt[0], zy = eye[1] - tgt[1], zz = eye[2] - tgt[2];\n    var zl = Math.hypot(zx, zy, zz) || 1; zx /= zl; zy /= zl; zz /= zl;\n    var xx = up[1] * zz - up[2] * zy, xy = up[2] * zx - up[0] * zz, xz = up[0] * zy - up[1] * zx;\n    var xl = Math.hypot(xx, xy, xz) || 1; xx /= xl; xy /= xl; xz /= xl;\n    var yx = zy * xz - zz * xy, yy = zz * xx - zx * xz, yz = zx * xy - zy * xx;\n    return new Float32Array([\n      xx, yx, zx, 0,\n      xy, yy, zy, 0,\n      xz, yz, zz, 0,\n      -(xx * eye[0] + xy * eye[1] + xz * eye[2]),\n      -(yx * eye[0] + yy * eye[1] + yz * eye[2]),\n      -(zx * eye[0] + zy * eye[1] + zz * eye[2]),\n      1\n    ]);\n  }\n\n  function mat4Mul(a, b, out) {\n    for (var c = 0; c < 4; c++) {\n      var b0 = b[c * 4], b1 = b[c * 4 + 1], b2 = b[c * 4 + 2], b3 = b[c * 4 + 3];\n      out[c * 4]     = a[0] * b0 + a[4] * b1 + a[8] * b2 + a[12] * b3;\n      out[c * 4 + 1] = a[1] * b0 + a[5] * b1 + a[9] * b2 + a[13] * b3;\n      out[c * 4 + 2] = a[2] * b0 + a[6] * b1 + a[10] * b2 + a[14] * b3;\n      out[c * 4 + 3] = a[3] * b0 + a[7] * b1 + a[11] * b2 + a[15] * b3;\n    }\n    return out;\n  }\n\n  function projectPoint(mvp, x, y, z, w, h, out) {\n    var cx = mvp[0] * x + mvp[4] * y + mvp[8] * z + mvp[12];\n    var cy = mvp[1] * x + mvp[5] * y + mvp[9] * z + mvp[13];\n    var cw = mvp[3] * x + mvp[7] * y + mvp[11] * z + mvp[15];\n    if (cw <= 0.25) return false;\n    out[0] = (cx / cw * 0.5 + 0.5) * w;\n    out[1] = (-cy / cw * 0.5 + 0.5) * h;\n    return true;\n  }\n\n  function toHex(u8) {\n    var s = '';\n    for (var i = 0; i < u8.length; i++) {\n      var b = u8[i].toString(16);\n      s += b.length < 2 ? ('0' + b) : b;\n    }\n    return s;\n  }\n\n  function decodeBase64(b64) {\n    if (!b64) return null;\n    if (typeof atob === 'function') {\n      var bin = atob(b64);\n      var out = new Uint8Array(bin.length);\n      for (var i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);\n      return out;\n    }\n    if (typeof Buffer === 'function') {\n      return new Uint8Array(Buffer.from(b64, 'base64'));\n    }\n    return null;\n  }\n\n  /* Pure-Omega OM3D Binary Mesh Decoder + Cryptographic Header Verifier */\n  function decodeOm3dBytes(bytes) {\n    if (!bytes || bytes.length < 64) return null;\n    if (bytes[0] !== 79 || bytes[1] !== 77 || bytes[2] !== 51 || bytes[3] !== 68) return null;\n    var dv = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);\n    var ver = dv.getUint32(4, true);\n    var vcount = dv.getUint32(8, true);\n    var icount = dv.getUint32(12, true);\n    var stride = dv.getUint32(16, true);\n    var flags = dv.getUint32(20, true);\n    if (ver !== 2 || stride !== 16 || vcount === 0 || icount === 0) return null;\n    var needBytes = 64 + vcount * 16 + icount * 2;\n    if (bytes.length < needBytes) return null;\n\n    /* Expand 16-byte Omega quantized vertices into 12-float aligned GPU vertex buffer (48 B/vert) */\n    var verts = new Float32Array(vcount * 12);\n    var inv256 = 1.0 / 256.0;\n    var inv127 = 1.0 / 127.0;\n    var inv255 = 1.0 / 255.0;\n    for (var i = 0; i < vcount; i++) {\n      var so = 64 + i * 16;\n      var vo = i * 12;\n      verts[vo]     = dv.getInt16(so, true) * inv256;\n      verts[vo + 1] = dv.getInt16(so + 2, true) * inv256;\n      verts[vo + 2] = dv.getInt16(so + 4, true) * inv256;\n      verts[vo + 3] = dv.getInt8(so + 6) * inv127;\n      verts[vo + 4] = dv.getInt8(so + 7) * inv127;\n      verts[vo + 5] = dv.getInt8(so + 8) * inv127;\n      verts[vo + 6] = bytes[so + 10] * inv255;\n      verts[vo + 7] = bytes[so + 11] * inv255;\n      verts[vo + 8] = bytes[so + 12] * inv255;\n      verts[vo + 9] = (bytes[so + 13] * inv255) * 2.4;\n      verts[vo + 10] = bytes[so + 9];\n      verts[vo + 11] = bytes[so + 15] * inv255;\n    }\n\n    var idxOff = 64 + vcount * 16;\n    var idxAligned = icount + (icount & 1);\n    var indices = new Uint16Array(idxAligned);\n    for (var k = 0; k < icount; k++) {\n      indices[k] = dv.getUint16(idxOff + k * 2, true);\n    }\n\n    var hdrSha = toHex(bytes.subarray(32, 64));\n    return {\n      raw: bytes,\n      payload: bytes.subarray(64),\n      headerSha: hdrSha,\n      version: ver,\n      flags: flags,\n      vcount: vcount,\n      icount: icount,\n      triCount: (icount / 3) | 0,\n      verts: verts,\n      indices: indices\n    };\n  }\n\n  var cachedMeshPromise = null;\n  var cachedMesh = null;\n\n  function loadAndVerifyOm3d(worldUrl) {\n    if (cachedMesh) return Promise.resolve(cachedMesh);\n    if (cachedMeshPromise) return cachedMeshPromise;\n\n    cachedMeshPromise = (async function () {\n      var bytes = null;\n      if (worldUrl && worldUrl !== 'off' && typeof fetch === 'function') {\n        try {\n          var urlStr = String(worldUrl);\n          if (urlStr.charAt(0) === '/' || urlStr.charAt(0) === '.') {\n            var res = await fetch(urlStr, { credentials: 'same-origin' });\n            if (res && res.ok) {\n              bytes = new Uint8Array(await res.arrayBuffer());\n            }\n          }\n        } catch (_) {\n          bytes = null;\n        }\n      }\n      if (!bytes) bytes = decodeBase64(OM3D_B64);\n      var mesh = decodeOm3dBytes(bytes);\n      if (!mesh) return null;\n\n      mesh.shaVerified = false;\n      mesh.shaShort = mesh.headerSha.slice(0, 12);\n      if (typeof crypto !== 'undefined' && crypto.subtle && typeof crypto.subtle.digest === 'functio