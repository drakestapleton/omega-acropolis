    { shaderLocation: 0, offset: 0, format: 'float32x4' },\n              { shaderLocation: 1, offset: 16, format: 'float32x4' }\n            ]\n          }]\n        },\n        fragment: {\n          module: rsMod,\n          entryPoint: 'fs_star',\n          targets: [{\n            format: fmt,\n            blend: {\n              color: { srcFactor: 'one', dstFactor: 'one', operation: 'add' },\n              alpha: { srcFactor: 'one', dstFactor: 'one', operation: 'add' }\n            }\n          }]\n        },\n        primitive: { topology: 'line-list' },\n        depthStencil: { format: 'depth24plus', depthWriteEnabled: false, depthCompare: 'less' }\n      });\n\n      var err = await device.popErrorScope();\n      if (err) return null;\n    } catch (_) {\n      return null;\n    }\n\n    var compBg = device.createBindGroup({\n      layout: compPipe.getBindGroupLayout(0),\n      entries: [\n        { binding: 0, resource: { buffer: uniBuf } },\n        { binding: 1, resource: { buffer: starBuf } }\n      ]\n    });\n    var objBg = device.createBindGroup({\n      layout: objPipe.getBindGroupLayout(0),\n      entries: [{ binding: 0, resource: { buffer: uniBuf } }]\n    });\n    var helixBg = device.createBindGroup({\n      layout: helixPipe.getBindGroupLayout(0),\n      entries: [{ binding: 0, resource: { buffer: uniBuf } }]\n    });\n    var starBg = device.createBindGroup({\n      layout: starPipe.getBindGroupLayout(0),\n      entries: [{ binding: 0, resource: { buffer: uniBuf } }]\n    });\n\n    var depthTex = null;\n    var depthView = null;\n    var depW = 0, depH = 0;\n\n    function ensureDepth(w, h) {\n      if (w === depW && h === depH && depthView) return;\n      if (depthTex) depthTex.destroy();\n      depW = w; depH = h;\n      depthTex = device.createTexture({\n        size: [w, h],\n        format: 'depth24plus',\n        usage: GPUTextureUsage.RENDER_ATTACHMENT\n      });\n      depthView = depthTex.createView();\n    }\n\n    function render(mvp, eye, tgt, fov, timeSec, dt, warpSpeed, dayMix, focusPos) {\n      if (contextLost) return;\n      var w = canvas.width | 0, h = canvas.height | 0;\n      if (w <= 0 || h <= 0) return;\n      ensureDepth(w, h);\n\n      uniData.set(mvp, 0);\n      uniData[16] = eye[0]; uniData[17] = eye[1]; uniData[18] = eye[2]; uniData[19] = 1.0;\n      uniData[20] = focusPos[0]; uniData[21] = focusPos[1]; uniData[22] = focusPos[2]; uniData[23] = focusPos[3];\n      uniData[24] = timeSec; uniData[25] = dt; uniData[26] = warpSpeed; uniData[27] = dayMix;\n      device.queue.writeBuffer(uniBuf, 0, uniData);\n\n      var tex = null;\n      try { tex = ctx.getCurrentTexture(); } catch (_) { return; }\n      var view = tex.createView();\n      var clearC = dayMix > 0.5\n        ? { r: lerp(0.0, 0.84, dayMix), g: lerp(0.0, 0.91, dayMix), b: lerp(0.0, 0.98, dayMix), a: 1.0 }\n        : { r: 0.0, g: 0.0, b: 0.0, a: 1.0 };\n\n      var enc = device.createCommandEncoder();\n      var cp = enc.beginComputePass();\n      cp.setPipeline(compPipe);\n      cp.setBindGroup(0, compBg);\n      cp.dispatchWorkgroups(Math.ceil(starCount / 64));\n      cp.end();\n\n      var rp = enc.beginRenderPass({\n        colorAttachments: [{ view: view, clearValue: clearC, loadOp: 'clear', storeOp: 'store' }],\n        depthStencilAttachment: { view: depthView, depthClearValue: 1.0, depthLoadOp: 'clear', depthStoreOp: 'store' }\n      });\n\n      if (!isAmbient && om3dVbo && om3dIbo && om3dIcount > 0) {\n        rp.setPipeline(objPipe);\n        rp.setBindGroup(0, objBg);\n        rp.setVertexBuffer(0, om3dVbo);\n        rp.setIndexBuffer(om3dIbo, 'uint16');\n        rp.drawIndexed(om3dIcount);\n      }\n\n      rp.setPipeline(helixPipe);\n      rp.setBindGroup(0, helixBg);\n      rp.setVertexBuffer(0, helixVbo);\n      rp.setIndexBuffer(helixIbo, 'uint16');\n      rp.drawIndexed(helixMesh.icount);\n\n      rp.setPipeline(starPipe);\n      rp.setBindGroup(0, starBg);\n      rp.setVertexBuffer(0, starBuf);\n      rp.draw(2, starCount, 0, 0);\n      rp.end();\n\n      device.queue.submit([enc.finish()]);\n    }\n\n    return {\n      backend: 'webgpu',\n      starCount: starCount,\n      uploadOm3d: uploadOm3d,\n      render: render,\n      destroy: function () {\n        contextLost = true;\n        if (depthTex) depthTex.destroy();\n        if (om3dVbo) om3dVbo.destroy();\n        if (om3dIbo) om3dIbo.destroy();\n        helixVbo.destroy();\n        helixIbo.destroy();\n        starBuf.destroy();\n        uniBuf.destroy();\n      }\n    };\n  }\n\n  /* =========================================================================\n   * BACKEND 2: ZERO-UPLOAD WEBGL2 + HALF-RES HDR BLOOM + ACES/CAS\n   * (ZERO per-frame bufferSubData, 100% GPU vertex/fragment animation)\n   * ========================================================================= */\n  function createAstralWebGL2(canvas, isAmbient, helixMesh, initialOm3d) {\n    var gl = null;\n    try {\n      gl = canvas.getContext('webgl2', {\n        antialias: false,\n        depth: true,\n        alpha: false,\n        powerPreference: 'high-performance'\n      });\n    } catch (_) {\n      gl = null;\n    }\n    if (!gl) return null;\n\n    var hasHalfFloat = Boolean(gl.getExtension('EXT_color_buffer_half_float'));\n    var starCount = isAmbient ? 2400 : 4096;\n    var starSeeds = buildStaticStarSeeds(starCount);\n\n    function compile(type, src) {\n      var sh = gl.createShader(type);\n      gl.shaderSource(sh, src);\n      gl.compileShader(sh);\n      if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {\n        gl.deleteShader(sh);\n        return null;\n      }\n      return sh;\n    }\n\n    function link(vsSrc, fsSrc) {\n      var vs = compile(gl.VERTEX_SHADER, vsSrc);\n      var fs = compile(gl.FRAGMENT_SHADER, fsSrc);\n      if (!vs || !fs) return null;\n      var prg = gl.createProgram();\n      gl.attachShader(prg, vs);\n      gl.attachShader(prg, fs);\n      gl.linkProgram(prg);\n      gl.deleteShader(vs);\n      gl.deleteShader(fs);\n      if (!gl.getProgramParameter(prg, gl.LINK_STATUS)) {\n        gl.deleteProgram(prg);\n        return null;\n      }\n      return prg;\n    }\n\n    var objPrg = link(\n      '#version 300 es\\n' +\n      'layout(location=0) in vec3 a_pos;\\n' +\n      'layout(location=1) in vec3 a_nrm;\\n' +\n      'layout(location=2) in vec3 a_col;\\n' +\n      'layout(location=3) in vec3 a_mat;\\n' +\n      'uniform mat4 u_mvp;\\n' +\n      'uniform float u_time;\\n' +\n      'uniform float u_warp;\\n' +\n      'uniform int u_isHelix;\\n' +\n      'out vec3 v_pos, v_nrm, v_col, v_mat;\\n' +\n      'vec3 rotY(vec3 p, float a){ float c=cos(a), s=sin(a); return vec3(p.x*c+p.z*s, p.y, -p.x*s+p.z*c); }\\n' +\n      'vec3 rotX(vec3 p, float a){ float c=cos(a), s=sin(a); return vec3(p.x, p.y*c-p.z*s, p.y*s+p.z*c); }\\n' +\n      'void main(){\\n' +\n      '  vec3 p = a_pos; vec3 n = a_nrm; vec3 m = a_mat;\\n' +\n      '  if(u_isHelix == 1){\\n' +\n      '    float hid = a_mat.y; float seed = a_mat.z;\\n' +\n      '    float ang = seed * 6.2831853 + hid * 0.57;\\n' +\n      '    float rr = 11.0 + fract(seed * 7.31) * 32.0;\\n' +\n      '    float zt = 170.0 - fract(seed * 3.17 + u_time * (0.045 + fract(seed * 5.1) * 0.04) * u_warp) * 195.0;\\n' +\n      '    p = rotY(p, u_time * 2.4 + seed * 6.28);\\n' +\n      '    p = rotX(p, 0.35 * sin(u_time + hid));\\n' +\n      '    p += vec3(cos(ang) * rr, sin(ang) * rr * 0.68 + 6.0, zt);\\n' +\n      '    n = rotY(n, u_time * 2.4 + seed * 6.28);\\n' +\n      '    m = vec3(a_mat.x, 1.0, 0.1);\\n' +\n      '  } else {\\n' +\n      '    int g = int(a_mat.y + 0.5);\\n' +\n      '    vec3 core = vec3(0.0, 7.6, -2.5);\\n' +\n      '    if(g == 0){ float pl = 1.0 + sin(u_time * 2.2) * 0.06; p = core + rotY((p - core) * pl, u_time * 0.45); n = rotY(n, u_time * 0.45); }\\n' +\n      '    else if(g == 1){ p = core + rotY(p - core, u_time * 0.6 + sin(p.y * 0.14 + u_time * 1.1) * 0.12); n = rotY(n, u_time * 0.6); }\\n' +\n      '    else if(g == 2){ p = core + rotX(rotY(p - core, u_time * 0.55), u_time * 0.28); n = rotX(rotY(n, u_time * 0.55), u_time * 0.28); }\\n' +\n      '    else if(g == 3){ p = core + rotY(rotX(p - core, -u_time * 0.42), u_time * 0.35); n = rotY(rotX(n, -u_time * 0.42), u_time * 0.35); }\\n' +\n      '    else if(g == 4){ p = core + rotX(rotY(p - core, -u_time * 0.24), -u_time * 0.48); n = rotX(rotY(n, -u_time * 0.24), -u_time * 0.48); }\\n' +\n      '    else if(g >= 5 && g <= 8){\\n' +\n      '      vec3 pc = vec3(12.4, 4.1, 7.4);\\n' +\n      '      if(g == 6) pc = vec3(-12.2, 5.2, -7.8);\\n' +\n      '      else if(g == 7) pc = vec3(-11.8, 4.1, 8.6);\\n' +\n      '      else if(g == 8) pc = vec3(6.4, 4.1, 14.8);\\n' +\n      '      float sp = u_time * (0.42 + float(g - 5) * 0.11);\\n' +\n      '      p = pc + vec3(0.0, sin(u_time * 1.2 + float(g) * 1.6) * 0.35, 0.0) + rotY(p - pc, sp);\\n' +\n      '      n = rotY(n, sp);\\n' +\n      '    }\\n' +\n      '  }\\n' +\n      '  v_pos = p; v_nrm = normalize(n); v_col = a_col; v_mat = m;\\n' +\n      '  gl_Position = u_mvp * vec4(p, 1.0);\\n' +\n      '}\\n',\n      '#version 300 es\\n' +\n      'precision highp float;\\n' +\n      'in vec3 v_pos, v_nrm, v_col, v_mat;\\n' +\n      'uniform vec3 u_eye;\\n' +\n      'uniform vec4 u_focus;\\n' +\n      'uniform float u_dayMix;\\n' +\n      'out vec4 o_hdr;\\n' +\n      'void main(){\\n' +\n      '  vec3 N = normalize(v_nrm);\\n' +\n      '  vec3 V = normalize(u_eye - v_pos);\\n' +\n      '  vec3 L = normalize(vec3(0.0, 7.6, -2.5) - v_pos + vec3(0.001, 0.25, 0.001));\\n' +\n      '  float ndl = max(dot(N, L), 0.18);\\n' +\n      '  float fres = pow(1.0 - max(dot(N, V), 0.0), 2.8);\\n' +\n      '  vec3 H = normalize(L + V);\\n' +\n      '  float spec = pow(max(dot(N, H), 0.0), 36.0) * 1.15;\\n' +\n      '  float pulse = exp(-length(v_pos - u_focus.xyz) * 0.14) * u_focus.w;\\n' +\n      '  float dm = clamp(u_dayMix, 0.0, 1.0);\\n' +\n      '  vec3 inkCol = mix(v_col, v_col * 0.40 + vec3(0.02, 0.04, 0.08), dm);\\n' +\n      '  vec3 hdr = inkCol * (0.28 + ndl * 0.95 + v_mat.x * mix(0.85, 0.35, dm)) + inkCol * (fres * mix(1.35, 0.45, dm) + pulse * 0.95) + vec3(spec * (1.0 - dm * 0.72));\\n' +\n      '  float dist = length(v_pos - u_eye);\\n' +\n      '  float fog = clamp((dist - 12.0) / 145.0, 0.0, 0.88);\\n' +\n      '  hdr = mix(hdr, mix(vec3(0.0, 0.01, 0.03), vec3(0.76, 0.84, 0.93), dm), fog);\\n' +\n      '  o_hdr = vec4(max(hdr, vec3(0.0)), 1.0);\\n' +\n      '}\\n'\n    );\n\n    var starPrg = link(\n      '#version 300 es\\n' +\n      'layout(location=0) in vec4 a_star;\\n' +\n      'uniform mat4 u_mvp;\\n' +\n      'uniform float u_time;\\n' +\n      'uniform float u_warp;\\n' +\n      'uniform float u_dpr;\\n' +\n      'out vec3 v_col;\\n' +\n      'void main(){\\n' +\n      '  float sp = 28.0 + fract(a_star.w) * 72.0;\\n' +\n      '  float z = mod(a_star.z - u_time * sp * u_warp, 195.0) - 18.0;\\n' +\n      '  float sw = u_time * 0.08 + a_star.z * 0.1;\\n' +\n      '  float c = cos(sw); float s = sin(sw);\\n' +\n      '  vec3 wp = vec3(a_star.x * c - a_star.y * s, a_star.x * s + a_star.y * c + 3.0, z);\\n' +\n      '  int st = int(a_star.w);\\n' +\n      '  vec3 sc = vec3(0.22, 0.88, 0.98);\\n' +\n      '  if(st == 1) sc = vec3(1.0, 0.82, 0.35);\\n' +\n      '  else if(st == 2) sc = vec3(0.42, 0.68, 1.0);\\n' +\n      '  else if(st == 3) sc = vec3(0.24, 0.88, 0.66);\\n' +\n      '  float fade = clamp((z + 18.0) / 28.0, 0.0, 1.0);\\n' +\n      '  v_col = mix(sc, vec3(1.0), 0.48) * (1.45 * fade);\\n' +\n      '  vec4 clip = u_mvp * vec4(wp, 1.0);\\n' +\n      '  gl_Position = clip;\\n' +\n      '  gl_PointSize = clamp((24.0 * u_dpr * (0.4 + fract(a_star.w))) / max(clip.w, 1.0), 1.5, 9.0);\\n' +\n      '}\\n',\n      '#version 300 es\\n' +\n      'precision mediump float;\\n' +\n      'in vec3 v_col;\\n' +\n      'out vec4 o_hdr;\\n' +\n      'void main(){\\n' +\n      '  vec2 d = gl_PointCoord - 0.5;\\n' +\n      '  float r2