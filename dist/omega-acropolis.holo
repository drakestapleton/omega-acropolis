oal.tx = clamp(goal.tx + (-sy * fwd + cy * strafe) * spd, -26, 26);\n        goal.tz = clamp(goal.tz + (-cy * fwd - sy * strafe) * spd, -26, 26);\n      }\n\n      var ease = reducedMotion ? 1.0 : (1.0 - Math.exp(-dt * 6.5));\n      cam.yaw = lerp(cam.yaw, goal.yaw, ease);\n      cam.pitch = lerp(cam.pitch, goal.pitch, ease);\n      cam.dist = lerp(cam.dist, goal.dist, ease);\n      cam.tx = lerp(cam.tx, goal.tx, ease);\n      cam.ty = lerp(cam.ty, goal.ty, ease);\n      cam.tz = lerp(cam.tz, goal.tz, ease);\n      dayMix = lerp(dayMix, dayTarget, reducedMotion ? 1.0 : (1.0 - Math.exp(-dt * 4.5)));\n\n      var cp = Math.cos(cam.pitch), sp = Math.sin(cam.pitch);\n      eyeVec[0] = cam.tx + Math.sin(cam.yaw) * cp * cam.dist;\n      eyeVec[1] = cam.ty + sp * cam.dist;\n      eyeVec[2] = cam.tz + Math.cos(cam.yaw) * cp * cam.dist;\n      tgtVec[0] = cam.tx; tgtVec[1] = cam.ty; tgtVec[2] = cam.tz;\n\n      var fov = Math.PI / 3.1;\n      var proj = mat4Perspective(fov, cssW / Math.max(cssH, 1), 0.35, 240.0);\n      var view = mat4LookAt(eyeVec, tgtVec, [0, 1, 0]);\n      mat4Mul(proj, view, lastMvp);\n\n      if (renderer) {\n        renderer.render(lastMvp, eyeVec, tgtVec, fov, tSec, dt, reducedMotion ? 0.2 : warpSpeed, dayMix, focusVec, Math.min(window.devicePixelRatio || 1, 1.5));\n      }\n\n      if (!isAmbient) {\n        for (var i = 0; i < PORTALS.length; i++) {\n          var pt = PORTALS[i];\n          var vis = projectPoint(lastMvp, pt.pos[0], pt.pos[1] + pt.pinOffset, pt.pos[2], cssW, cssH, projTmp);\n          var pinEl = pinButtons[i];\n          if (vis && projTmp[0] > 28 && projTmp[0] < cssW - 28 && projTmp[1] > 64 && projTmp[1] < cssH - 92) {\n            pinEl.style.opacity = '1';\n            pinEl.style.pointerEvents = 'auto';\n            pinEl.style.transform = 'translate(' + projTmp[0].toFixed(1) + 'px,' + projTmp[1].toFixed(1) + 'px) translate(-50%,-100%)';\n          } else {\n            pinEl.style.opacity = '0';\n            pinEl.style.pointerEvents = 'none';\n          }\n        }\n        for (var c = 0; c < CELESTIAL_SIGILS.length; c++) {\n          var cs = CELESTIAL_SIGILS[c];\n          var ang = cs.phase + (reducedMotion ? 0 : tSec * 0.16);\n          var ox = Math.cos(ang) * cs.radius;\n          var oz = Math.sin(ang) * cs.radius - 2.5;\n          var oy = cs.height + 1.2 + (reducedMotion ? 0 : Math.sin(tSec * 0.9 + c * 1.7) * 0.85);\n          var cvis = projectPoint(lastMvp, ox, oy, oz, cssW, cssH, projTmp);\n          var celEl = celestialLabels[c];\n          if (cvis && projTmp[0] > 20 && projTmp[0] < cssW - 20 && projTmp[1] > 56 && projTmp[1] < cssH - 90) {\n            celEl.style.opacity = '0.84';\n            celEl.style.transform = 'translate(' + projTmp[0].toFixed(1) + 'px,' + projTmp[1].toFixed(1) + 'px) translate(-50%,-50%)';\n          } else {\n            celEl.style.opacity = '0';\n          }\n        }\n        if (nowMs - lastHudMs > 450) updateTelemetry(nowMs);\n      }\n    }\n\n    if (!isAmbient) updateTelemetry(0);\n    rafId = requestAnimationFrame(step);\n\n    var api = {\n      version: VERSION,\n      setTheme: setTheme,\n      getTheme: function () { return theme; },\n      selectPortal: function (idOrIdx) {\n        if (typeof idOrIdx === 'number') { selectPortal(idOrIdx, false); return; }\n        for (var i = 0; i < PORTALS.length; i++) {\n          if (PORTALS[i].id === idOrIdx) { selectPortal(i, false); return; }\n        }\n        selectPortal(-1, false);\n      },\n      resetView: resetView,\n      setCamera: function (yaw, pitch, dist) {\n        autoOrbit = false;\n        if (typeof yaw === 'number') goal.yaw = yaw;\n        if (typeof pitch === 'number') goal.pitch = clamp(pitch, -0.35, 1.15);\n        if (typeof dist === 'number') goal.dist = clamp(dist, 11.0, 62.0);\n      },\n      getStatus: function () {\n        return {\n          version: VERSION,\n          theme: theme,\n          backend: renderer ? renderer.backend : 'none',\n          om3dVerified: Boolean(om3dMesh && om3dMesh.shaVerified),\n          om3dSha256: om3dMesh ? om3dMesh.headerSha : null,\n          totalTriangles: totalTris,\n          particles: renderer ? renderer.starCount : 0,\n          warpSpeed: warpSpeed,\n          drsScale: drsScale,\n          p95Ms: +p95Ms.toFixed(2),\n          stutters: stutters,\n          activePortal: activePortalIdx >= 0 ? PORTALS[activePortalIdx].id : null,\n          shield: auditZeroTrackingShield()\n        };\n      },\n      destroy: function () {\n        destroyed = true;\n        cancelAnimationFrame(rafId);\n        if (renderer && typeof renderer.destroy === 'function') renderer.destroy();\n        if (!isAmbient) window.__acropolisPortalActive = false;\n        delete container.__acropolisInstance;\n      }\n    };\n\n    container.__acropolisInstance = api;\n    return api;\n  }\n\n  function autoMount() {\n    var nodes = document.querySelectorAll('[data-acropolis-world], #acropolis-world');\n    var hasAmbient = false;\n    for (var i = 0; i < nodes.length; i++) {\n      if (nodes[i].getAttribute('data-mode') === 'ambient') hasAmbient = true;\n      mount(nodes[i]);\n    }\n    /* On real browser pages without an explicit ambient backdrop, attach full-screen void-black starfield + flying DNA */\n    if (!hasAmbient && document.body && typeof document.body.prepend === 'function' && !document.getElementById('acropolis-ambient')) {\n      var bg = document.createElement('div');\n      bg.id = 'acropolis-ambient';\n      bg.className = 'acr-ambient-stage';\n      bg.setAttribute('data-acropolis-world', 'true');\n      bg.setAttribute('data-mode', 'ambient');\n      bg.setAttribute('aria-hidden', 'true');\n      document.body.prepend(bg);\n      mount(bg);\n    }\n  }\n\n  window.AcropolisWorld = {\n    version: VERSION,\n    portals: PORTALS,\n    themes: ['aegean', 'parian'],\n    mount: mount\n  };\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', autoMount, { once: true });\n  } else {\n    autoMount();\n  }\n})();\n\n;(function () {\n  'use strict';\n  var V = (typeof window !== 'undefined' && window.verdant) ? window.verdant : null;\n  var host = document.getElementById('acropolis-world');\n  var log = document.getElementById('acr-holo-log');\n  if (!host || !window.AcropolisWorld) return;\n  var inst = window.AcropolisWorld.mount(host, { site: 'standalone', theme: 'aegean', worldUrl: 'off' });\n\n  function updateLog(reason) {\n    var st = inst.getStatus();\n    if (log) {\n      log.textContent =\n        'ACROPOLIS PRISM (' + reason + ') | backend=' + st.backend +\n        ' | theme=' + st.theme +\n        ' | tris=' + st.totalTriangles +\n        ' | particles=' + st.particles +\n        ' | portal=' + (st.activePortal || 'overview') +\n        ' | 3p_hosts=' + st.shield.thirdPartyResources;\n    }\n    if (V && typeof V.emit === 'function') {\n      V.emit('acropolis.telemetry', { reason: reason, status: st }, {\n        'acropolis.theme': st.theme,\n        'acropolis.backend': st.backend,\n        'acropolis.triangles': st.totalTriangles,\n        'acropolis.third_party': st.shield.thirdPartyResources\n      });\n    }\n    if (V && V.sense && typeof V.sense.emitVisualFrame === 'function') {\n      V.sense.emitVisualFrame({\n        width: host.clientWidth || 960,\n        height: host.clientHeight || 560,\n        coherent: true,\n        theme: st.theme,\n        triangles: st.totalTriangles,\n        particles: st.particles\n      });\n    }\n    return st;\n  }\n\n  host.addEventListener('acropolis:portal', function (ev) {\n    ev.preventDefault();\n    var p = ev.detail && ev.detail.portal ? ev.detail.portal : null;\n    if (p && V && typeof V.emit === 'function') {\n      V.emit('acropolis.portal', { id: p.id, name: p.name, sigil: p.sigil, href: ev.detail.href }, { 'acropolis.portal': p.id });\n    }\n    updateLog('portal:' + (p ? p.id : 'none'));\n  });\n\n  host.addEventListener('acropolis:theme', function (ev) {\n    var th = ev.detail && ev.detail.theme ? ev.detail.theme : inst.getTheme();\n    if (V && typeof V.emit === 'function') {\n      V.emit('acropolis.theme', { theme: th }, { 'acropolis.theme': th });\n    }\n    updateLog('theme:' + th);\n  });\n\n  if (V && typeof V.onInput === 'function') {\n    V.onInput(async function (payload) {\n      var cmd = typeof payload === 'string' ? { action: payload.trim().toLowerCase() } : (payload || {});\n      var action = String(cmd.action || 'status').toLowerCase();\n      if (action === 'theme') {\n        inst.setTheme(cmd.theme === 'parian' ? 'parian' : 'aegean');\n        return { ok: true, status: updateLog('cmd-theme') };\n      }\n      if (action === 'portal') {\n        inst.selectPortal(cmd.portal || 'omega');\n        return { ok: true, status: updateLog('cmd-portal') };\n      }\n      if (action === 'camera') {\n        inst.setCamera(cmd.yaw, cmd.pitch, cmd.dist);\n        return { ok: true, status: updateLog('cmd-camera') };\n      }\n      if (action === 'reset') {\n        inst.resetView();\n        return { ok: true, status: updateLog('cmd-reset') };\n      }\n      if (action === 'shield' || action === 'inspect') {\n        var st = updateLog('cmd-' + action);\n        if (V && typeof V.emit === 'function') {\n          V.emit('acropolis.shield', st.shield, { 'acropolis.third_party': st.shield.thirdPartyResources });\n        }\n        return { ok: true, shield: st.shield, status: st };\n      }\n      return { ok: true, status: updateLog('cmd-status') };\n    });\n  }\n\n  setTimeout(function () {\n    if (V && typeof V.emit === 'function') {\n      V.emit('prism.ready', { name: 'omega-acropolis', version: inst.version });\n    }\n    updateLog('boot-ready');\n  }, 400);\n})();\n"
  }
}
