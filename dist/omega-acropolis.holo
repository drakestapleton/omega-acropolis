)), 1.0);\\n' +\n      '}\\n'\n    );\n\n    if (!objPrg || !starPrg || !postPrg) return null;\n\n    function createStaticMeshVao(verts, indices, icount) {\n      var vao = gl.createVertexArray();\n      var vbo = gl.createBuffer();\n      var ibo = gl.createBuffer();\n      gl.bindVertexArray(vao);\n      gl.bindBuffer(gl.ARRAY_BUFFER, vbo);\n      gl.bufferData(gl.ARRAY_BUFFER, verts, gl.STATIC_DRAW);\n      gl.enableVertexAttribArray(0); gl.vertexAttribPointer(0, 3, gl.FLOAT, false, 48, 0);\n      gl.enableVertexAttribArray(1); gl.vertexAttribPointer(1, 3, gl.FLOAT, false, 48, 12);\n      gl.enableVertexAttribArray(2); gl.vertexAttribPointer(2, 3, gl.FLOAT, false, 48, 24);\n      gl.enableVertexAttribArray(3); gl.vertexAttribPointer(3, 3, gl.FLOAT, false, 48, 36);\n      gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, ibo);\n      gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, indices, gl.STATIC_DRAW);\n      gl.bindVertexArray(null);\n      return { vao: vao, vbo: vbo, ibo: ibo, count: icount };\n    }\n\n    var helixVao = createStaticMeshVao(helixMesh.verts, helixMesh.indices, helixMesh.icount);\n    var om3dVao = initialOm3d ? createStaticMeshVao(initialOm3d.verts, initialOm3d.indices, initialOm3d.icount) : null;\n\n    var starVao = gl.createVertexArray();\n    var starVbo = gl.createBuffer();\n    gl.bindVertexArray(starVao);\n    gl.bindBuffer(gl.ARRAY_BUFFER, starVbo);\n    gl.bufferData(gl.ARRAY_BUFFER, starSeeds, gl.STATIC_DRAW);\n    gl.enableVertexAttribArray(0); gl.vertexAttribPointer(0, 4, gl.FLOAT, false, 16, 0);\n    gl.bindVertexArray(null);\n\n    var quadVao = gl.createVertexArray();\n\n    /* Half-Res HDR + Bloom FBOs */\n    var hdrTex = gl.createTexture(), hdrDep = gl.createRenderbuffer(), hdrFbo = gl.createFramebuffer();\n    var bloomTex = gl.createTexture(), bloomFbo = gl.createFramebuffer();\n    var hdrW = 0, hdrH = 0;\n\n    function ensureHdr(w, h) {\n      if (!hasHalfFloat || isAmbient) return false;\n      if (w === hdrW && h === hdrH) return true;\n      hdrW = w; hdrH = h;\n      var bw = Math.max(2, w >> 1), bh = Math.max(2, h >> 1);\n      gl.bindTexture(gl.TEXTURE_2D, hdrTex);\n      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA16F, w, h, 0, gl.RGBA, gl.HALF_FLOAT, null);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\n      gl.bindRenderbuffer(gl.RENDERBUFFER, hdrDep);\n      gl.renderbufferStorage(gl.RENDERBUFFER, gl.DEPTH_COMPONENT24, w, h);\n      gl.bindFramebuffer(gl.FRAMEBUFFER, hdrFbo);\n      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, hdrTex, 0);\n      gl.framebufferRenderbuffer(gl.FRAMEBUFFER, gl.DEPTH_ATTACHMENT, gl.RENDERBUFFER, hdrDep);\n\n      gl.bindTexture(gl.TEXTURE_2D, bloomTex);\n      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA16F, bw, bh, 0, gl.RGBA, gl.HALF_FLOAT, null);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);\n      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);\n      gl.bindFramebuffer(gl.FRAMEBUFFER, bloomFbo);\n      gl.framebufferTexture2D(gl.FRAMEBUFFER, gl.COLOR_ATTACHMENT0, gl.TEXTURE_2D, bloomTex, 0);\n      gl.bindFramebuffer(gl.FRAMEBUFFER, null);\n      return true;\n    }\n\n    var uObj = {\n      mvp: gl.getUniformLocation(objPrg, 'u_mvp'),\n      time: gl.getUniformLocation(objPrg, 'u_time'),\n      warp: gl.getUniformLocation(objPrg, 'u_warp'),\n      isHelix: gl.getUniformLocation(objPrg, 'u_isHelix'),\n      eye: gl.getUniformLocation(objPrg, 'u_eye'),\n      focus: gl.getUniformLocation(objPrg, 'u_focus'),\n      dayMix: gl.getUniformLocation(objPrg, 'u_dayMix')\n    };\n    var uStar = {\n      mvp: gl.getUniformLocation(starPrg, 'u_mvp'),\n      time: gl.getUniformLocation(starPrg, 'u_time'),\n      warp: gl.getUniformLocation(starPrg, 'u_warp'),\n      dpr: gl.getUniformLocation(starPrg, 'u_dpr')\n    };\n    var uPost = {\n      hdr: gl.getUniformLocation(postPrg, 'u_hdr'),\n      bloom: gl.getUniformLocation(postPrg, 'u_bloom'),\n      invRes: gl.getUniformLocation(postPrg, 'u_invRes'),\n      mode: gl.getUniformLocation(postPrg, 'u_mode')\n    };\n\n    function uploadOm3d(mesh) {\n      if (!mesh || gl.isContextLost()) return;\n      if (om3dVao) {\n        gl.deleteVertexArray(om3dVao.vao);\n        gl.deleteBuffer(om3dVao.vbo);\n        gl.deleteBuffer(om3dVao.ibo);\n      }\n      om3dVao = createStaticMeshVao(mesh.verts, mesh.indices, mesh.icount);\n    }\n\n    function render(mvp, eye, tgt, fov, timeSec, dt, warpSpeed, dayMix, focusPos, dpr) {\n      var w = canvas.width | 0, h = canvas.height | 0;\n      if (w <= 0 || h <= 0 || gl.isContextLost()) return;\n\n      var useHdr = ensureHdr(w, h);\n      gl.bindFramebuffer(gl.FRAMEBUFFER, useHdr ? hdrFbo : null);\n      gl.viewport(0, 0, w, h);\n      if (dayMix > 0.5) {\n        gl.clearColor(lerp(0.0, 0.84, dayMix), lerp(0.0, 0.91, dayMix), lerp(0.0, 0.98, dayMix), 1.0);\n      } else {\n        gl.clearColor(0.0, 0.0, 0.0, 1.0);\n      }\n      gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);\n\n      gl.enable(gl.DEPTH_TEST);\n      gl.depthMask(true);\n      gl.useProgram(objPrg);\n      gl.uniformMatrix4fv(uObj.mvp, false, mvp);\n      gl.uniform1f(uObj.time, timeSec);\n      gl.uniform1f(uObj.warp, warpSpeed);\n      gl.uniform3fv(uObj.eye, eye);\n      gl.uniform4fv(uObj.focus, focusPos);\n      gl.uniform1f(uObj.dayMix, dayMix);\n\n      if (!isAmbient && om3dVao && om3dVao.count > 0) {\n        gl.uniform1i(uObj.isHelix, 0);\n        gl.bindVertexArray(om3dVao.vao);\n        gl.drawElements(gl.TRIANGLES, om3dVao.count, gl.UNSIGNED_SHORT, 0);\n      }\n\n      gl.unifor