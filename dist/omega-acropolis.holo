{
  "schema": "verdant-ui/holo/1",
  "digest": "sha256:3e8d397652995a1ff69efac073ecee00a52e1e5630db1358e14c67f5f97367ce",
  "name": "Omega Astral Cosmos v2.0 - Pure OM-2 Universe",
  "summary": "Interactive Omega Astral Cosmos 3D World powered by pure seeded OM-2 compiled OM3D geometry verified live via SHA-256, WebGPU compute warp stars, 24 flying 4-strand DNA helices, zero-upload WebGL2 HDR bloom, and CBF 4K frame pacing (zero WASM, zero tracking).",
  "streams": {
    "inputs": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "status",
            "theme",
            "portal",
            "camera",
            "reset",
            "inspect",
            "shield"
          ],
          "description": "Command to dispatch to the live Spatial Acropolis 3D World Prism."
        },
        "theme": {
          "type": "string",
          "enum": [
            "aegean",
            "parian"
          ],
          "description": "Theme selection for action=theme (Aegean Night or Sunlit Parian Marble)."
        },
        "portal": {
          "type": "string",
          "enum": [
            "omega",
            "harmonia",
            "forge",
            "aien",
            "shame"
          ],
          "description": "Portal target for action=portal."
        },
        "yaw": {
          "type": "number",
          "description": "Camera orbit yaw in radians for action=camera."
        },
        "pitch": {
          "type": "number",
          "description": "Camera pitch in radians (0.09..1.18) for action=camera."
        },
        "dist": {
          "type": "number",
          "description": "Camera orbit radius (11.5..62.0) for action=camera."
        }
      },
      "required": [
        "action"
      ]
    },
    "outputs": [
      "prism.ready",
      "acropolis.telemetry",
      "acropolis.portal",
      "acropolis.theme",
      "acropolis.shield",
      "sensory"
    ]
  },
  "grants": {
    "observer": true,
    "storage": false,
    "browser": true,
    "network": false
  },
  "app": {
    "html": "<div class=\"acr-holo-shell\">\n  <section id=\"acropolis-world\" data-acropolis-world=\"true\" data-site=\"standalone\" data-theme=\"aegean\" data-world-url=\"off\" aria-label=\"Omega Astral Cosmos 3D World\"></section>\n  <pre id=\"acr-holo-log\" class=\"acr-insp-receipt\">Booting Omega Astral Cosmos Prism (Pure OM-2 Compiled)...</pre>\n</div>",
    "css": ":root{--acr-night-bg:#000000;--acr-night-surface:#030712e6;--acr-night-card:#060d1ff2;--acr-night-border:#1e3a68;--acr-night-border-gold:#f5c45188;--acr-night-ink:#f8fafc;--acr-night-muted:#b8cae8;--acr-night-gold:#f5c451;--acr-night-bronze:#d4972a;--acr-night-cyan:#22d3ee;--acr-night-azure:#60a5fa;--acr-night-emerald:#2dd4a0;--acr-night-terra:#ef5b3c;--acr-night-btn:#0c1c3e;--acr-night-btn-hover:#152e60;--acr-night-btn-ink:#f8fafc;--acr-night-cta-bg:#f5c451;--acr-night-cta-hover:#ffd56b;--acr-night-cta-ink:#030712;--acr-night-shadow:#000000cc;--acr-day-bg:#e8f1fb;--acr-day-surface:#faf5eae8;--acr-day-card:#fffbf2f5;--acr-day-border:#c9b998;--acr-day-border-gold:#b8801688;--acr-day-ink:#12223d;--acr-day-muted:#3d5070;--acr-day-gold:#a66e08;--acr-day-bronze:#8c5b0a;--acr-day-cyan:#087ea4;--acr-day-azure:#1d56c4;--acr-day-emerald:#0f8a64;--acr-day-terra:#c44125;--acr-day-btn:#ede3cf;--acr-day-btn-hover:#e2d3b5;--acr-day-btn-ink:#12223d;--acr-day-cta-bg:#143d8a;--acr-day-cta-hover:#1b4fb0;--acr-day-cta-ink:#faf5ea;--acr-day-shadow:#12223d30;--acr-bg:var(--acr-night-bg);--acr-surface:var(--acr-night-surface);--acr-card:var(--acr-night-card);--acr-border:var(--acr-night-border);--acr-border-gold:var(--acr-night-border-gold);--acr-ink:var(--acr-night-ink);--acr-muted:var(--acr-night-muted);--acr-gold:var(--acr-night-gold);--acr-bronze:var(--acr-night-bronze);--acr-cyan:var(--acr-night-cyan);--acr-azure:var(--acr-night-azure);--acr-emerald:var(--acr-night-emerald);--acr-terra:var(--acr-night-terra);--acr-btn:var(--acr-night-btn);--acr-btn-hover:var(--acr-night-btn-hover);--acr-btn-ink:var(--acr-night-btn-ink);--acr-cta-bg:var(--acr-night-cta-bg);--acr-cta-hover:var(--acr-night-cta-hover);--acr-cta-ink:var(--acr-night-cta-ink);--acr-shadow:var(--acr-night-shadow);--acr-meander-a:#f5c45144;--acr-meander-b:#22d3ee33;--acr-flute-a:#ffffff10;--acr-flute-b:#00000018;--acr-serif:\"Latin Modern Roman\",Georgia,\"Palatino Linotype\",\"Book Antiqua\",Palatino,serif;--acr-sans:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Noto Sans\",Helvetica,Arial,sans-serif;--acr-mono:ui-monospace,SFMono-Regular,\"SF Mono\",Menlo,Consolas,monospace;--acr-radius-sm:6px;--acr-radius-md:12px;--acr-radius-lg:16px;--acr-radius-pill:999px}\n\n/* Omega Astral Cosmos v2.0 Stylesheet\n * 100% pure ASCII, all color literals confined strictly inside :root above.\n * Zero-tracking boundary & strict CSP (style-src self) compliant.\n */\n\n[data-acr-theme=\"parian\"],\n.acr-world[data-acr-theme=\"parian\"]{\n  --acr-bg:var(--acr-day-bg);\n  --acr-surface:var(--acr-day-surface);\n  --acr-card:var(--acr-day-card);\n  --acr-border:var(--acr-day-border);\n  --acr-border-gold:var(--acr-day-border-gold);\n  --acr-ink:var(--acr-day-ink);\n  --acr-muted:var(--acr-day-muted);\n  --acr-gold:var(--acr-day-gold);\n  --acr-bronze:var(--acr-day-bronze);\n  --acr-cyan:var(--acr-day-cyan);\n  --acr-azure:var(--acr-day-azure);\n  --acr-emerald:var(--acr-day-emerald);\n  --acr-terra:var(--acr-day-terra);\n  --acr-btn:var(--acr-day-btn);\n  --acr-btn-hover:var(--acr-day-btn-hover);\n  --acr-btn-ink:var(--acr-day-btn-ink);\n  --acr-cta-bg:var(--acr-day-cta-bg);\n  --acr-cta-hover:var(--acr-day-cta-hover);\n  --acr-cta-ink:var(--acr-day-cta-ink);\n  --acr-shadow:var(--acr-day-shadow);\n}\n\n.acr-world{\n  position:relative;\n  width:100%;\n  min-height:580px;\n  height:clamp(560px,80vh,860px);\n  background:var(--acr-bg);\n  color:var(--acr-ink);\n  font-family:var(--acr-sans);\n  overflow:hidden;\n  overflow-x:clip;\n  border-top:1px solid var(--acr-border-gold);\n  border-bottom:1px solid var(--acr-border-gold);\n  box-sizing:border-box;\n  isolation:isolate;\n  user-select:none;\n}\n\n.acr-world *{\n  box-sizing:border-box;\n}\n\n.acr-world.acr-ambient{\n  position:fixed;\n  inset:0;\n  width:100vw;\n  height:100vh;\n  min-height:100vh;\n  z-index:0;\n  border:0;\n  pointer-events:none;\n}\n\n.acr-world.acr-ambient .acr-canvas{\n  cursor:default;\n  pointer-events:none;\n}\n\n.acr-world.acr-ambient .acr-topbar,\n.acr-world.acr-ambient .acr-dock-wrap,\n.acr-world.acr-ambient .acr-pins,\n.acr-world.acr-ambient .acr-inspector,\n.acr-world.acr-ambient .acr-flute-left,\n.acr-world.acr-ambient .acr-flute-right{\n  display:none;\n}\n\n.acr-world.acr-fullscreen{\n  position:fixed;\n  inset:0;\n  width:100vw;\n  height:100vh;\n  min-height:100vh;\n  z-index:9990;\n  border:0;\n}\n\n.acr-meander{\n  position:absolute;\n  left:0;\n  right:0;\n  height:3px;\n  z-index:12;\n  pointer-events:none;\n  background-image:linear-gradient(90deg,var(--acr-cyan),var(--acr-gold),var(--acr-azure),var(--acr-emerald));\n  opacity:0.75;\n}\n\n.acr-meander-top{top:0}\n.acr-meander-bot{bottom:0}\n\n.acr-flute-left,\n.acr-flute-right{\n  position:absolute;\n  top:3px;\n  bottom:3px;\n  width:4px;\n  z-index:11;\n  pointer-events:none;\n  background:linear-gradient(180deg,var(--acr-cyan),var(--acr-gold),var(--acr-emerald));\n  opacity:0.28;\n}\n\n.acr-flute-left{left:0}\n.acr-flute-right{right:0}\n\n.acr-canvas{\n  position:absolute;\n  inset:0;\n  width:100%;\n  height:100%;\n  display:block;\n  cursor:grab;\n  touch-action:pan-y;\n}\n\n.acr-canvas:active{\n  cursor:grabbing;\n}\n\n.acr-canvas:focus-visible{\n  outline:2px solid var(--acr-gold);\n  outline-offset:-3px;\n}\n\n.acr-pins{\n  position:absolute;\n  inset:0;\n  z-index:6;\n  pointer-events:none;\n  overflow:hidden;\n}\n\n.acr-pin{\n  position:absolute;\n  left:0;\n  top:0;\n  transform:translate(-50%,-100%);\n  pointer-events:auto;\n  display:inline-flex;\n  align-items:center;\n  gap:7px;\n  padding:5px 11px 5px 7px;\n  border-radius:var(--acr-radius-pill);\n  border:1px solid var(--acr-border-gold);\n  background:var(--acr-surface);\n  color:var(--acr-ink);\n  font-family:var(--acr-sans);\n  font-size:12px;\n  font-weight:600;\n  letter-spacing:0.02em;\n  line-height:1.1;\n  white-space:nowrap;\n  cursor:pointer;\n  box-shadow:0 6px 22px var(--acr-shadow);\n  transition:border-color 160ms ease,background-color 160ms ease,opacity 160ms ease;\n}\n\n.acr-pin:hover,\n.acr-pin:focus-visible,\n.acr-pin.acr-pin-active{\n  border-color:var(--acr-gold);\n  background:var(--acr-card);\n  outline:2px solid var(--acr-gold);\n  outline-offset:1px;\n  z-index:8;\n}\n\n.acr-pin-glyph{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  min-width:24px;\n  height:24px;\n  padding:0 5px;\n  border-radius:var(--acr-radius-pill);\n  font-family:var(--acr-serif);\n  font-size:13px;\n  font-weight:700;\n  color:var(--acr-cta-ink);\n  background:var(--acr-gold);\n}\n\n.acr-pin[data-accent=\"cyan\"] .acr-pin-glyph{background:var(--acr-cyan)}\n.acr-pin[data-accent=\"azure\"] .acr-pin-glyph{background:var(--acr-azure)}\n.acr-pin[data-accent=\"emerald\"] .acr-pin-glyph{background:var(--acr-emerald)}\n.acr-pin[data-accent=\"terra\"] .acr-pin-glyph{background:var(--acr-terra)}\n\n.acr-pin-label{\n  font-family:var(--acr-serif);\n  font-size:12px;\n  letter-spacing:0.03em;\n}\n\n.acr-celestial{\n  position:absolute;\n  left:0;\n  top:0;\n  transform:translate(-50%,-50%);\n  pointer-events:none;\n  font-family:var(--acr-serif);\n  font-size:15px;\n  font-weight:700;\n  color:var(--acr-gold);\n  text-shadow:0 0 14px var(--acr-meander-a);\n  opacity:0.84;\n}\n\n.acr-topbar{\n  position:absolute;\n  top:12px;\n  left:16px;\n  right:16px;\n  z-index:10;\n  display:flex;\n  flex-wrap:wrap;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:10px;\n  pointer-events:none;\n}\n\n.acr-title-plaque{\n  pointer-events:auto;\n  max-width:340px;\n  padding:8px 12px;\n  border-radius:var(--acr-radius-md);\n  border:1px solid var(--acr-border-gold);\n  background:var(--acr-surface);\n  box-shadow:0 10px 30px var(--acr-shadow);\n}\n\n.acr-kicker{\n  display:flex;\n  align-items:center;\n  gap:7px;\n  font-family:var(--acr-mono);\n  font-size:9.5px;\n  font-weight:600;\n  letter-spacing:0.11em;\n  text-transform:uppercase;\n  color:var(--acr-gold);\n  margin:0 0 3px;\n}\n\n.acr-dot{\n  display:inline-block;\n  width:7px;\n  height:7px;\n  border-radius:var(--acr-radius-pill);\n  background:var(--acr-emerald);\n  flex:none;\n}\n\n.acr-world .acr-title-plaque h2.acr-heading,\n.acr-heading{\n  margin:0;\n  font-family:var(--acr-serif);\n  font-size:clamp(15px,1.75vw,19px);\n  font-weight:700;\n  letter-spacing:0.02em;\n  line-height:1.15;\n  color:var(--acr-ink);\n}\n\n.acr-sub{\n  margin:3px 0 0;\n  font-size:11px;\n  line-height:1.35;\n  color:var(--acr-muted);\n}\n\n.acr-controls{\n  pointer-events:auto;\n  display:flex;\n  flex-wrap:wrap;\n  align-items:center;\n  justify-content:flex-end;\n  gap:5px;\n}\n\n.acr-btn{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  gap:5px;\n  min-height:29px;\n  padding:4px 8px;\n  border-radius:var(--acr-radius-sm);\n  border:1px solid var(--acr-border);\n  background:var(--acr-surface);\n  color:var(--acr-btn-ink);\n  font-family:var(--acr-mono);\n  font-size:10.5px;\n  font-weight:600;\n  letter-spacing:0.03em;\n  cursor:pointer;\n  box-shadow:0 4px 14px var(--acr-shadow);\n  transition:border-color 140ms ease,background-color 140ms ease;\n}\n\n.acr-btn:hover,\n.acr-btn:focus-visible{\n  border-color:var(--acr-gold);\n  background:var(--acr-btn-hover);\n  outline:none;\n}\n\n.acr-btn-gold{\n  border-color:var(--acr-border-gold);\n  color:var(--acr-gold);\n}\n\n.acr-btn-warp{\n  border-color:var(--acr-cyan);\n  color:var(--acr-cyan);\n}\n\n.acr-btn-cta{\n  background:var(--acr-cta-bg);\n  color:var(--acr-cta-ink);\n  border-color:var(--acr-cta-bg);\n  text-decoration:none;\n}\n\n.acr-btn-cta:hover,\n.acr-btn-cta:focus-visible{\n  background:var(--acr-cta-hover);\n  border-color:var(--acr-cta-hover);\n  color:var(--acr-cta-ink);\n}\n\n.acr-telemetry{\n  display:inline-flex;\n  align-items:center;\n  gap:6px;\n  padding:4px 8px;\n  border-radius:var(--acr-radius-sm);\n  border:1px solid var(--acr-border);\n  background:var(--acr-surface);\n  font-family:var(--acr-mono);\n  font-size:10px;\n  letter-spacing:0.03em;\n  color:var(--acr-muted);\n  white-space:nowrap;\n}\n\n.acr-telemetry strong{\n  color:var(--acr-emerald);\n  font-weight:700;\n}\n\n.acr-inspector{\n  position:absolute;\n  top:90px;\n  right:16px;\n  width:min(368px,calc(100% - 32px));\n  z-index:11;\n  padding:15px;\n  border-radius:var(--acr-radius-md);\n  border:1px solid var(--acr-border-gold);\n  background:var(--acr-card);\n  box-shadow:0 18px 46px var(--acr-shadow);\n  display:flex;\n  flex-direction:column;\n  gap:10px;\n}\n\n.acr-inspector[hidden]{\n  display:none;\n}\n\n.acr-insp-head{\n  display:flex;\n  align-items:center;\n  gap:10px;\n}\n\n.acr-insp-sigil{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  min-width:40px;\n  height:40px;\n  padding:0 8px;\n  border-radius:var(--acr-radius-sm);\n  border:1px solid var(--acr-border-gold);\n  background:var(--acr-btn);\n  color:var(--acr-gold);\n  font-family:var(--acr-serif);\n  font-size:18px;\n  font-weight:700;\n}\n\n.acr-insp-titles{\n  min-width:0;\n  flex:1;\n}\n\n.acr-insp-ep{\n  display:block;\n  font-family:var(--acr-mono);\n  font-size:10px;\n  letter-spacing:0.1em;\n  text-transform:uppercase;\n  color:var(--acr-gold);\n}\n\n.acr-insp-name{\n  margin:2px 0 0;\n  font-family:var(--acr-serif);\n  font-size:18px;\n  font-weight:700;\n  line-height:1.2;\n  color:var(--acr-ink);\n}\n\n.acr-insp-close{\n  min-width:30px;\n  height:30px;\n  padding:0;\n  border-radius:var(--acr-radius-sm);\n  border:1px solid var(--acr-border);\n  background:var(--acr-btn);\n  color:var(--acr-ink);\n  font-family:var(--acr-mono);\n  font-size:13px;\n  cursor:pointer;\n}\n\n.acr-insp-close:hover{\n  border-color:var(--acr-gold);\n}\n\n.acr-insp-desc{\n  margin:0;\n  font-size:13px;\n  line-height:1.55;\n  color:var(--acr-muted);\n}\n\n.acr-insp-receipt{\n  margin:0;\n  padding:9px 10px;\n  border-radius:var(--acr-radius-sm);\n  border:1px solid var(--acr-border);\n  background:var(--acr-bg);\n  color:var(--acr-ink);\n  font-family:var(--acr-mono);\n  font-size:11px;\n  line-height:1.5;\n  white-space:pre-wrap;\n  word-break:break-word;\n}\n\n.acr-insp-actions{\n  display:flex;\n  flex-wrap:wrap;\n  gap:8px;\n  align-items:center;\n}\n\n.acr-dock-wrap{\n  position:absolute;\n  left:16px;\n  right:16px;\n  bottom:12px;\n  z-index:10;\n  display:flex;\n  flex-direction:column;\n  gap:6px;\n  pointer-events:none;\n}\n\n.acr-hint{\n  align-self:flex-start;\n  padding:3px 9px;\n  border-radius:var(--acr-radius-pill);\n  border:1px solid var(--acr-border);\n  background:var(--acr-surface);\n  font-family:var(--acr-mono);\n  font-size:10px;\n  letter-spacing:0.04em;\n  color:var(--acr-muted);\n}\n\n.acr-dock{\n  pointer-events:auto;\n  display:grid;\n  grid-template-columns:repeat(5,minmax(0,1fr));\n  gap:8px;\n}\n\n.acr-portal-btn{\n  display:flex;\n  align-items:center;\n  gap:9px;\n  padding:8px 10px;\n  border-radius:var(--acr-radius-sm);\n  border:1px solid var(--acr-border);\n  border-top:2px solid var(--acr-border-gold);\n  background:var(--acr-surface);\n  color:var(--acr-ink);\n  text-align:left;\n  cursor:pointer;\n  box-shadow:0 6px 18px var(--acr-shadow);\n  transition:border-color 150ms ease,background-color 150ms ease;\n}\n\n.acr-portal-btn:hover,\n.acr-portal-btn:focus-visible,\n.acr-portal-btn.acr-portal-active{\n  border-color:var(--acr-gold);\n  background:var(--acr-card);\n  outline:none;\n}\n\n.acr-portal-sigil{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  min-width:30px;\n  height:30px;\n  padding:0 5px;\n  border-radius:var(--acr-radius-sm);\n  background:var(--acr-btn);\n  border:1px solid var(--acr-border-gold);\n  color:var(--acr-gold);\n  font-family:var(--acr-serif);\n  font-size:14px;\n  font-weight:700;\n  flex:none;\n}\n\n.acr-portal-btn[data-accent=\"cyan\"] .acr-portal-sigil{color:var(--acr-cyan)}\n.acr-portal-btn[data-accent=\"azure\"] .acr-portal-sigil{color:var(--acr-azure)}\n.acr-portal-btn[data-accent=\"emerald\"] .acr-portal-sigil{color:var(--acr-emerald)}\n.acr-portal-btn[data-accent=\"terra\"] .acr-portal-sigil{color:var(--acr-terra)}\n\n.acr-portal-meta{\n  min-width:0;\n  display:flex;\n  flex-direction:column;\n  gap:1px;\n}\n\n.acr-portal-name{\n  font-family:var(--acr-serif);\n  font-size:13px;\n  font-weight:700;\n  line-height:1.2;\n  color:var(--acr-ink);\n  overflow:hidden;\n  text-overflow:ellipsis;\n  white-space:nowrap;\n}\n\n.acr-portal-role{\n  font-family:var(--acr-mono);\n  font-size:10px;\n  line-height:1.2;\n  color:var(--acr-muted);\n  overflow:hidden;\n  text-overflow:ellipsis;\n  white-space:nowrap;\n}\n\n@media (max-width:960px){\n  .acr-dock{\n    grid-template-columns:repeat(3,minmax(0,1fr));\n  }\n}\n\n@media (max-width:640px){\n  .acr-world{\n    min-height:520px;\n    height:clamp(520px,82vh,700px);\n  }\n  .acr-topbar{\n    top:8px;\n    left:10px;\n    right:10px;\n    gap:6px;\n  }\n  .acr-title-plaque{\n    max-width:100%;\n    padding:6px 10px;\n  }\n  .acr-sub{\n    display:none;\n  }\n  .acr-telemetry{\n    display:none;\n  }\n  .acr-btn[data-acr-action=\"quality\"],\n  .acr-btn[data-acr-action=\"audio\"]{\n    display:none;\n  }\n  .acr-inspector{\n    top:auto;\n    bottom:112px;\n    left:12px;\n    right:12px;\n    width:auto;\n    padding:12px;\n  }\n  .acr-dock-wrap{\n    left:12px;\n    right:12px;\n    bottom:10px;\n  }\n  .acr-hint{\n    display:none;\n  }\n  .acr-dock{\n    grid-template-columns:repeat(2,minmax(0,1fr));\n    gap:6px;\n  }\n  .acr-portal-btn{\n    padding:6px 8px;\n    gap:7px;\n  }\n  .acr-portal-role{\n    display:none;\n  }\n  .acr-pin-label{\n    display:none;\n  }\n}\n\n@media (prefers-reduced-motion:reduce){\n  .acr-pin,\n  .acr-btn,\n  .acr-portal-btn{\n    transition:none;\n  }\n}\n\n.acr-holo-shell{display:grid;gap:10px;max-width:1180px;margin:0 auto}\n",
    "js": "/*\n * Omega Astral Cosmos v2.0 World Engine\n * Pure Seeded OM-2 Compiled Geometry (OM3D + live WebCrypto FIPS 180-4 SHA-256 verification)\n * Dual GPU Backend: WebGPU Compute (12,288 GPU-resident warp particles + instanced 4-strand DNA helices)\n *                   + Zero-Upload WebGL2 Half-Res HDR Bloom & ACES/CAS\n *                   + omega-observer / omega-play CBF Adaptive 4K Frame Pacer + IntersectionObserver Sleep\n *\n * Security & Privacy Contract:\n * - Zero WASM, zero CDN, zero third-party network fetches, zero cookies, zero storage.\n * - Zero dynamic HTML parsing, zero eval, 100% printable ASCII bytes.\n * - Compliant with strict CSP (script-src 'self', style-src 'self').\n */\n(function () {\n  'use strict';\n\n  var VERSION = '2.0.0';\n\n  /* OM3D_META_BEGIN */\n  var OM3D_FILE_SHA256 = '2975bab00f07e71ec01175d3c6573ec4b5755efa178ba98cf5e461fa9a246b18';\n  var OM3D_PAYLOAD_SHA256 = '3b7cd0d9e7151c9be9ac25254afdd5c38b0f66d93c1253baeaa3c7ff71fe9806';\n  var OM3D_B64 = '';\n  /* OM3D_META_END */\n\n  var PORTALS = [\n    {\n      id: 'omega',\n      sigil: '\\u03A9',\n      name: 'Omega Singularity Core',\n      role: 'Seeded Compiler & Zero-CUDA Silicon',\n      epithet: 'CORE CONSTELLATION',\n      accent: 'gold',\n      color: [0.96, 0.77, 0.32],\n      pos: [0.0, 7.6, -2.5],\n      pinOffset: 2.2,\n      cam: { yaw: 0.36, pitch: 0.24, dist: 21.5, tx: 0.0, ty: 7.8, tz: -2.2 },\n      routes: { aienos: '/omega/', interplane: '/omega/', standalone: '#omega-singularity' },\n      desc: 'Unifies omega-mv, omega-helix, omega-turbo, omega-gpu-driver, aienux, and omega-4k-merkle: 408 B seed to 281 KB static GPU runner with zero CUDA, HIP, ROCr, Vulkan, OpenCL, or libc.',\n      receipt: 'SILICON: 459 TFLOPS NVFP4 & 260,243 tok/s BF16 on GB10\\n4K MERKLE: 119.8 fps Delta render (5.14x vs ffmpeg, -83% J)'\n    },\n    {\n      id: 'harmonia',\n      sigil: '\\u03A6\\u03C0\\u03B5',\n      name: 'Harmonia & Math Nebula',\n      role: 'Symbolic Cal