r('pointerup', function () { dragging = false; });\n    canvas.addEventListener('wheel', function (e) {\n      if (!container.classList.contains('acr-fullscreen')) return;\n      e.preventDefault();\n      goal.dist = clamp(goal.dist + e.deltaY * 0.025, 11.0, 62.0);\n    }, { passive: false });\n    canvas.addEventListener('keydown', function (e) {\n      var k = String(e.key || '').toLowerCase();\n      keys[k] = true;\n      if (k >= '1' && k <= '5') selectPortal(parseInt(k, 10) - 1, true);\n      if (k === '0' || k === 'r') resetView();\n      if (k === 'escape' && container.classList.contains('acr-fullscreen')) {\n        container.classList.remove('acr-fullscreen');\n        btnFs.textContent = 'Fullscreen';\n        syncSizeCache();\n      }\n    });\n    canvas.addEventListener('keyup', function (e) {\n      delete keys[String(e.key || '').toLowerCase()];\n    });\n\n    function updateTelemetry(nowMs) {\n      var n = dtCount;\n      var sum = 0;\n      for (var i = 0; i < n; i++) {\n        var v = dtRing[i];\n        dtSorted[i] = v;\n        sum += v;\n      }\n      if (n > 1) {\n        for (var a = 1; a < n; a++) {\n          var key = dtSorted[a];\n          var b = a - 1;\n          while (b >= 0 && dtSorted[b] > key) { dtSorted[b + 1] = dtSorted[b]; b--; }\n          dtSorted[b + 1] = key;\n        }\n        p95Ms = dtSorted[Math.min(n - 1, (n * 0.95) | 0)];\n      }\n      var avgMs = n > 0 ? sum / n : 16.67;\n      var fps = avgMs > 0 ? Math.round(1000 / avgMs) : 60;\n      var audit = auditZeroTrackingShield();\n      var bName = renderer ? renderer.backend.toUpperCase() : '2D';\n      var seal = om3dMesh ? (om3dMesh.shaVerified ? 'OM3D SHA-256' : 'OM3D') : 'OM3D';\n      telEngine.textContent = seal + ' \\u00B7 ' + bName;\n      telRest.textContent = ' \\u00B7 ' + fps + ' FPS \\u00B7 DRS ' + drsScale.toFixed(2) + ' \\u00B7 ' + audit.thirdPartyResources + ' 3P';\n      lastHudMs = nowMs;\n    }\n\n    function step(nowMs) {\n      if (destroyed)